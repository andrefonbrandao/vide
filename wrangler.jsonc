// Configuração do Cloudflare (Worker com arquivos estáticos + serviço de mensagens).
// O Cloudflare roda "npm run build" e publica a pasta "dist" e o worker/index.ts.
{
  "name": "vide",
  "compatibility_date": "2026-10-01",
  "main": "worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Só os endereços /api/ passam pelo worker; o resto é servido direto.
    "run_worker_first": ["/api/*"]
  },
  // Salas de pareamento celular <-> computador e do jogo de perguntas (Durable Objects, plano gratuito).
  "durable_objects": {
    "bindings": [
      { "name": "SALAS", "class_name": "Sala" },
      { "name": "JOGOS", "class_name": "Jogo" },
      { "name": "TREINOS", "class_name": "Treino" },
      { "name": "PROCESSOS", "class_name": "Processo" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Sala"] },
    // Salas do jogo de perguntas (alunos respondendo pelo celular).
    { "tag": "v2", "new_sqlite_classes": ["Jogo"] },
    // Treinos em casa (cópias de grupos de questões compartilhadas por link).
    { "tag": "v3", "new_sqlite_classes": ["Treino"] },
    // Processos fictícios que a turma acompanha (só os eventos já liberados são lidos pelos alunos).
    { "tag": "v4", "new_sqlite_classes": ["Processo"] }
  ],
  "workers_dev": true,
  "preview_urls": false
}
