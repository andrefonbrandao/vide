// Configuração do Cloudflare (Worker com arquivos estáticos + serviço de mensagens).
// O Cloudflare roda "npm run build" e publica a pasta "dist" e o worker/index.ts.
{
  "name": "vide",
  "compatibility_date": "2026-10-01",
  "main": "worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Passam pelo worker os endereços /api/ e as páginas (para o porteiro conferir a senha do
    // professor); os arquivos do app (scripts, estilos, imagens) são servidos direto.
    "run_worker_first": ["/*", "!/assets/*", "!/*.png", "!/*.svg", "!/*.webmanifest"]
  },
  // Salas de pareamento celular <-> computador e do jogo de perguntas (Durable Objects, plano gratuito).
  "durable_objects": {
    "bindings": [
      { "name": "SALAS", "class_name": "Sala" },
      { "name": "JOGOS", "class_name": "Jogo" },
      { "name": "TREINOS", "class_name": "Treino" },
      { "name": "PROCESSOS", "class_name": "Processo" },
      { "name": "ORIENTACOES", "class_name": "Orientacao" },
      { "name": "PORTEIROS", "class_name": "Porteiro" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Sala"] },
    // Salas do jogo de perguntas (alunos respondendo pelo celular).
    { "tag": "v2", "new_sqlite_classes": ["Jogo"] },
    // Treinos em casa (cópias de grupos de questões compartilhadas por link).
    { "tag": "v3", "new_sqlite_classes": ["Treino"] },
    // Processos fictícios que a turma acompanha (só os eventos já liberados são lidos pelos alunos).
    { "tag": "v4", "new_sqlite_classes": ["Processo"] },
    // Páginas dos orientandos (cronograma, pendências, elementos e modelos; leitura só com o código de 6 números).
    { "tag": "v5", "new_sqlite_classes": ["Orientacao"] },
    // Porteiro do app do professor (conta os erros de senha por endereço de internet).
    { "tag": "v6", "new_sqlite_classes": ["Porteiro"] }
  ],
  "workers_dev": true,
  "preview_urls": false
}
